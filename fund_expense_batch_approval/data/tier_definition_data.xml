<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Una sola firma: la del Gerente. Se puede cambiar el revisor o sumar
         niveles desde las definiciones de aprobación. -->
    <record id="tier_definition_fund_expense_batch" model="tier.definition">
        <field name="name">Conformidad del Gerente</field>
        <field name="model_id" ref="model_fund_expense_batch"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="group_fund_expense_batch_approver"/>
        <field name="sequence">10</field>
        <field name="notify_on_create" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
