<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A4 apaisado con más margen arriba: el encabezado de la compañía ocupa
         más que el margen estándar (desde la segunda hoja la grilla le pasaba
         por encima) y la grilla tiene muchas columnas. -->
    <record id="paperformat_fund_expense_batch" model="report.paperformat">
        <field name="name">A4 apaisado - Conformidad (encabezado alto)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">68</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">64</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_fund_expense_batch" model="ir.actions.report">
        <field name="name">Conformidad de rendiciones</field>
        <field name="paperformat_id" ref="paperformat_fund_expense_batch"/>
        <field name="model">fund.expense.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fund_expense_batch_approval.report_fund_expense_batch</field>
        <field name="report_file">fund_expense_batch_approval.report_fund_expense_batch</field>
        <field name="print_report_name">'Conformidad %s' % (object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_fund_expense_batch"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fund_expense_batch_document">
        <t t-call="web.external_layout">
            <t t-set="totals" t-value="o._fund_batch_totals()"/>
            <div class="page fe-batch" style="font-size: 0.85rem;">
                <!-- Grillas propias: el layout de la compañía redondea y oscurece
                     las tablas de Bootstrap de forma despareja. -->
                <style>
                    .fe-batch table.fe-grid {
                        width: 100%; margin-bottom: 14px;
                        border-collapse: collapse !important;
                        border: 1px solid #444 !important;
                        border-radius: 0 !important;
                        overflow: visible !important;
                    }
                    .fe-batch table.fe-grid th,
                    .fe-batch table.fe-grid td {
                        border: 1px solid #444 !important;
                        border-radius: 0 !important;
                        padding: 4px 6px;
                        vertical-align: top;
                        background: #fff !important;
                        color: #000 !important;
                    }
                    .fe-batch table.fe-grid th {
                        background: #ececec !important;
                        font-weight: bold;
                    }
                    .fe-batch table.fe-grid tfoot td {
                        background: #f5f5f5 !important;
                    }
                </style>
                <h3>Conformidad de rendiciones <span t-field="o.name"/></h3>
                <p>
                    Período: <span t-field="o.date_from"/> al <span t-field="o.date_to"/>
                    <t t-if="o.user_id"> · Responsable: <span t-field="o.user_id"/></t>
                </p>

                <table class="fe-grid">
                    <thead>
                        <tr>
                            <th>Anexo</th>
                            <th>Aprobado</th>
                            <th>Empleado</th>
                            <th>Área</th>
                            <th>Fondos</th>
                            <th>Documentos</th>
                            <th class="text-end">Importe</th>
                            <th>Observación</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.sheet_id.name"/></td>
                            <td><span t-field="line.approval_day"/></td>
                            <td><span t-field="line.employee_id"/></td>
                            <td><span t-field="line.department_id"/></td>
                            <td><span t-field="line.fund_source"/></td>
                            <td class="small"><span t-field="line.document_names"/></td>
                            <td class="text-end">
                                <span t-field="line.total_amount"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            <td><span t-if="line.observed" t-field="line.observation"/></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6"><strong>Total (<t t-out="len(o.line_ids)"/> Anexos)</strong></td>
                            <td class="text-end">
                                <strong t-field="o.amount_total"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            <td/>
                        </tr>
                    </tfoot>
                </table>

                <div class="row mt-4">
                    <div class="col-6">
                        <table class="fe-grid">
                            <thead><tr><th>Por área</th><th class="text-end">Importe</th></tr></thead>
                            <tbody>
                                <tr t-foreach="totals['by_area']" t-as="row">
                                    <td t-out="row[0]"/>
                                    <td class="text-end"
                                        t-out="row[1]"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-6">
                        <table class="fe-grid">
                            <thead><tr><th>Por fondo</th><th class="text-end">Importe</th></tr></thead>
                            <tbody>
                                <tr t-foreach="totals['by_source']" t-as="row">
                                    <td t-out="row[0]"/>
                                    <td class="text-end"
                                        t-out="row[1]"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-5" style="page-break-inside: avoid;">
                    <t t-if="o.state == 'approved'">
                        <p>
                            <strong>Conformidad:</strong> <span t-field="o.approved_by_id"/>,
                            <span t-field="o.approved_date"/>
                        </p>
                        <p t-if="o.observed_count">
                            Con <t t-out="o.observed_count"/> Anexo(s) observado(s).
                        </p>
                    </t>
                    <p t-else=""><strong>Conformidad pendiente.</strong></p>
                </div>
            </div>
        </t>
    </template>

    <template id="report_fund_expense_batch">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="fund_expense_batch_approval.report_fund_expense_batch_document"/>
            </t>
        </t>
    </template>
</odoo>
