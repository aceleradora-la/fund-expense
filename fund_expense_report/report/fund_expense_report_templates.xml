<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_fund_expense_anexo" model="ir.actions.report">
        <field name="name">Anexo I - Solicitud de fondos</field>
        <field name="model">hr.expense.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fund_expense_report.report_fund_expense_anexo</field>
        <field name="report_file">fund_expense_report.report_fund_expense_anexo</field>
        <field name="print_report_name">'Anexo I - %s' % (object.name)</field>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense_sheet"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Firma de un nivel aprobado en Odoo. -->
    <template id="fund_expense_anexo_signature">
        <td class="text-center align-top" style="width: 33%;">
            <div class="fw-bold mb-2" t-out="title"/>
            <t t-if="name">
                <div>FIRMA: <em>aprobado en Odoo</em></div>
                <div t-if="date">el <span t-out="date" t-options="{'widget': 'datetime'}"/></div>
                <div>ACLARACIÓN: <span t-out="name"/></div>
            </t>
            <t t-elif="note">
                <div class="text-muted" t-out="note"/>
            </t>
            <t t-else="">
                <div>FIRMA: ______________________</div>
                <div>ACLARACIÓN: ________________</div>
            </t>
        </td>
    </template>

    <template id="report_fund_expense_anexo_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.employee_id.work_contact_id.lang or o.env.lang)"/>
            <div class="page" style="font-size: 0.9rem;">
                <h4 class="text-center mb-3">ANEXO I: SOLICITUD DE FONDOS</h4>

                <table class="table table-sm table-bordered mb-3">
                    <tr>
                        <th style="width: 30%;">FECHA:</th>
                        <td><span t-field="o.create_date" t-options="{'widget': 'date'}"/></td>
                    </tr>
                    <tr>
                        <th>ÁREA REQUIRENTE:</th>
                        <td><span t-field="o.department_id"/></td>
                    </tr>
                    <tr>
                        <th>CONCEPTO:</th>
                        <td><span t-field="o.name"/></td>
                    </tr>
                    <tr>
                        <th>IMPORTE:</th>
                        <td><span t-field="o.total_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                    </tr>
                    <tr>
                        <th>SOLICITA ANTICIPO:</th>
                        <td>
                            <t t-if="o.advance">SÍ</t>
                            <t t-else="">NO</t>
                            <t t-if="o.advance_sheet_id">
                                — rinde el anticipo <span t-field="o.advance_sheet_id"/>
                            </t>
                        </td>
                    </tr>
                </table>

                <table class="table table-sm table-bordered mb-3">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Comprobante</th>
                            <th>Proveedor</th>
                            <th>Detalle</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.expense_line_ids" t-as="line">
                            <td><span t-field="line.date"/></td>
                            <td><span t-field="line.receipt_number"/></td>
                            <td>
                                <span t-field="line.vendor_id"/>
                                <t t-if="line.vendor_vat">
                                    <br/><small>CUIT <span t-field="line.vendor_vat"/></small>
                                </t>
                            </td>
                            <td><span t-field="line.name"/></td>
                            <td class="text-end">
                                <span t-field="line.total_amount_currency"
                                      t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <t t-set="area_review" t-value="o._fund_expense_signature('area')"/>
                <t t-set="afm_review" t-value="o._fund_expense_signature('afm')"/>
                <table class="table table-sm table-bordered mb-3">
                    <tr>
                        <t t-call="fund_expense_report.fund_expense_anexo_signature">
                            <t t-set="title">1. SOLICITANTE</t>
                            <t t-set="name" t-value="o.employee_id.name"/>
                            <t t-set="date" t-value="o.create_date"/>
                        </t>
                        <t t-call="fund_expense_report.fund_expense_anexo_signature">
                            <t t-set="title">2. RESPONSABLE ÁREA</t>
                            <t t-set="name" t-value="area_review.done_by.name"/>
                            <t t-set="date" t-value="area_review.reviewed_date"/>
                            <t t-set="note" t-value="not o.department_manager_user_id and 'No aplica: solicita el responsable del área'"/>
                        </t>
                        <t t-call="fund_expense_report.fund_expense_anexo_signature">
                            <t t-set="title">3. GERENCIA ADM. Y FIN.</t>
                            <t t-set="name" t-value="afm_review.done_by.name"/>
                            <t t-set="date" t-value="afm_review.reviewed_date"/>
                            <t t-set="note" t-value="False"/>
                        </t>
                    </tr>
                </table>

                <table class="table table-sm table-bordered">
                    <tr>
                        <th colspan="2">FONDOS (Uso exclusivo Administración)</th>
                    </tr>
                    <tr>
                        <td style="width: 50%;">
                            FONDO FIJO: <strong t-out="'[X]' if o.fund_source == 'fondo_fijo' else '[ ]'"/>
                        </td>
                        <td>
                            CAJA CHICA: <strong t-out="'[X]' if o.fund_source == 'caja_chica' else '[ ]'"/>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_fund_expense_anexo">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="fund_expense_report.report_fund_expense_anexo_document"/>
            </t>
        </t>
    </template>
</odoo>
