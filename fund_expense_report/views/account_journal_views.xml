<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_fund_expense" model="ir.ui.view">
        <field name="name">account.journal.form.fund.expense</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/field[@name='type']" position="after">
                <field name="fund_expense_source"
                       invisible="type not in ('bank', 'cash', 'credit')"/>
            </xpath>
        </field>
    </record>
</odoo>
