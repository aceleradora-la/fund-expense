<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fund_expense" model="ir.ui.view">
        <field name="name">account.move.form.fund.expense</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_fund_expense_pay_without_bill"
                        string="Pagar sin factura"
                        type="object"
                        invisible="not fund_expense_sheet_id or state != 'draft'"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="fund_expense_sheet_id" invisible="not fund_expense_sheet_id"/>
            </xpath>
        </field>
    </record>
</odoo>
