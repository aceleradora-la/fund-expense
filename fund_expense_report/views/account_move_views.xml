<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fund_expense" model="ir.ui.view">
        <field name="name">account.move.form.fund.expense</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_fund_expense_pay_without_bill"
                        string="Pagar sin factura"
                        type="object"
                        invisible="not fund_expense_sheet_id or state != 'draft'"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="fund_expense_sheet_id" invisible="not fund_expense_sheet_id"/>
            </xpath>
        </field>
    </record>

    <!-- La factura del Anexo nace en borrador sin número: la del proveedor llega
         después (o nunca, si se paga sin factura antes). El número deja de ser
         obligatorio para guardar el borrador; para confirmarla lo sigue exigiendo
         la localización (_check_l10n_latam_documents). -->
    <record id="view_move_form_fund_expense_latam" model="ir.ui.view">
        <field name="name">account.move.form.fund.expense.latam</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_move_form"/>
        <field name="arch" type="xml">
            <field name="l10n_latam_document_number" position="attributes">
                <attribute name="required">partner_id and l10n_latam_use_documents and l10n_latam_manual_document_number and not (fund_expense_sheet_id and state == 'draft')</attribute>
            </field>
        </field>
    </record>
</odoo>
